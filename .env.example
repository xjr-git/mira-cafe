# Copy to .env and fill in. ALL of these are OPTIONAL.
# Without a key the server runs fully in Mock mode (scripted story brain
# + EdgeTTS voice + preset polaroids), so the core flow is always demoable.

# Alibaba DashScope API key (enables qwen-plus LLM, CosyVoice TTS, wanx text2img)
DASHSCOPE_API_KEY=

# TTS provider: auto (dashscope if key present, else edge) | edge | dashscope
MIRA_TTS_PROVIDER=auto

# Image provider: auto (dashscope if key present, else mock) | mock | dashscope
MIRA_IMAGE_PROVIDER=auto

# LLM model (dashscope compatible mode). Story brain is used when no key.
MIRA_LLM_MODEL=qwen-plus

# Server port
MIRA_PORT=8000
